# Q-Prime NGINX Configuration
# Based on: https://github.com/wmnnd/nginx-certbot
#
# Environment variables substituted at container start:
#   ${DOMAIN} - Server domain name
#   ${HTTP_CLIENT_PREFIX} - Frontend route prefix (default: /ohq)
#   ${HTTP_API_PREFIX} - API route prefix (default: /api)

# WebSocket connection upgrade map
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Upstream definitions
upstream frontend {
    server frontend:80;
    keepalive 32;
}

upstream convex_api {
    server convex-backend:3210;
    keepalive 32;
}

upstream convex_site {
    server convex-backend:3211;
    keepalive 32;
}

# HTTP - ACME challenge and redirect to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    # ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS - Main server
server {
    listen 443 ssl http2;
    server_name ${DOMAIN};
    server_tokens off;

    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Let's Encrypt recommended settings
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ===========================================
    # Root - Redirect to client prefix
    # ===========================================
    location = / {
        return 302 ${HTTP_CLIENT_PREFIX}/;
    }

    # ===========================================
    # Frontend - ${HTTP_CLIENT_PREFIX}/*
    # ===========================================
    location ${HTTP_CLIENT_PREFIX}/ {
        rewrite ^${HTTP_CLIENT_PREFIX}/(.*) /$1 break;
        proxy_pass http://frontend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${HTTP_CLIENT_PREFIX} {
        return 302 ${HTTP_CLIENT_PREFIX}/;
    }

    # ===========================================
    # Convex HTTP Actions - CSV endpoints
    # ===========================================
    location ~ ^${HTTP_API_PREFIX}/(download_|upload_) {
        proxy_pass http://convex_site;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 10M;
    }

    # ===========================================
    # Convex Auth - OAuth callbacks
    # ===========================================
    location ${HTTP_API_PREFIX}/auth/ {
        proxy_pass http://convex_site;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===========================================
    # Convex API - Main API with WebSocket
    # ===========================================
    location ${HTTP_API_PREFIX}/ {
        rewrite ^${HTTP_API_PREFIX}/(.*) /$1 break;
        proxy_pass http://convex_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # ===========================================
    # OpenID Connect Discovery
    # ===========================================
    location /.well-known/openid-configuration {
        proxy_pass http://convex_site/.well-known/openid-configuration;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/jwks.json {
        proxy_pass http://convex_site/.well-known/jwks.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===========================================
    # Health check
    # ===========================================
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
