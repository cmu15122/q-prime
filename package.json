    "@mui/x-date-pickers": "^5.0.0-alpha.5",
    "@react-oauth/google": "^0.2.8",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.1.2",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "axios": "^1.7.9",
    "chart.js": "^4.4.1",
    "chat.js": "^1.0.2",
    "convex": "^1.31.4",
    "csvtojson": "^2.0.14",
    "downloadjs": "^1.4.7",
    "linkify-react": "^4.3.2",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "number-to-words": "^1.2.4",
    "react": "^18.1.0",
    "react-chartjs-2": "^5.2.0",
    "react-cookie": "^7.2.2",
    "react-dom": "^18.1.0",
    "react-router-dom": "^6.3.0",
    "react-toastify": "^11.0.5",
    "react-window": "^1.8.7",
    "slack-webhook": "^1.0.0",
    "socket.io-client": "^4.8.1",
    "styled-components": "^5.3.5",
    "typescript": "^5.9.3",
    "underscore": "^1.13.4",
    "universal-cookie": "^7.2.2",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.2.2"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "convex dev",
    "dev:frontend": "vite --open",
    "predev": "convex dev --until-success",
    "build": "npm run typecheck && npm run lint && vite build",
    "build:quick": "vite build",
    "deploy": "npx convex deploy --cmd-url-env-var-name VITE_APP_CONVEX_URL --cmd 'npm run build:quick'",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.convex.json --noEmit",
    "lint": "eslint src/ convex/",
    "lint:fix": "eslint src/ convex/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"convex/**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"convex/**/*.{ts,tsx,js}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
