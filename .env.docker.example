# ===========================================
# Q-PRIME DOCKER CONFIGURATION
# ===========================================
# Copy to .env.docker, fill in the REQUIRED values, then run:
#   ./docker/scripts/setup.sh
#
# The setup script will auto-generate everything else.

# ===========================================
# REQUIRED - You must fill these in
# ===========================================

# Your domain (use "localhost" for local testing)
DOMAIN=yourdomain.edu

# Let's Encrypt email (for SSL certificate notifications)
LETSENCRYPT_EMAIL=admin@yourdomain.edu

# Google OAuth credentials
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ===========================================
# AUTO-GENERATED - setup.sh fills these in
# ===========================================

# JWT Keys (generated by setup.sh)
JWT_PRIVATE_KEY=
JWKS=

# Convex admin key (generated by setup.sh)
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ===========================================
# DERIVED - setup.sh updates based on DOMAIN
# ===========================================

# Frontend URLs
VITE_CONVEX_URL=https://yourdomain.edu/api
VITE_APP_CONVEX_SITE_URL=https://yourdomain.edu/api
VITE_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend URLs
CONVEX_CLOUD_ORIGIN=https://yourdomain.edu/api
CONVEX_SITE_ORIGIN=https://yourdomain.edu
CONVEX_SITE_URL=https://yourdomain.edu

# Auth URLs
SITE_URL=https://yourdomain.edu

# CLI connection
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210

# ===========================================
# OPTIONAL
# ===========================================

# Set to 1 to use Let's Encrypt staging (for testing)
LETSENCRYPT_STAGING=0

# URL prefixes - change these if running multiple deployments on one machine
# Example: /ohq and /api for production, /ohq_dev and /api_dev for dev
HTTP_CLIENT_PREFIX=/ohq
HTTP_API_PREFIX=/api
