# Q-Prime Docker Configuration
# 1. Fill in the required values below
# 2. Run: ./docker/scripts/setup.sh
#
# setup.sh generates and manages everything else automatically.

# ── Required ──────────────────────────────────────────────────────────────────

# Your deployment domain
DOMAIN=yourdomain.edu
LETSENCRYPT_EMAIL=admin@yourdomain.edu
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret


# ── Optional ──────────────────────────────────────────────────────────────────

# URL path prefixes — change if running multiple deployments on one host
# HTTP_CLIENT_PREFIX=/ohq
# HTTP_API_PREFIX=/api

# Set to 1 to use Let's Encrypt staging server (avoids rate limits while testing)
# LETSENCRYPT_STAGING=0
